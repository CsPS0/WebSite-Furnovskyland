# Copy to .env.local for local development, or configure these in your hosting provider's environment settings.

# Public base URL of the site (e.g. https://example.com). Defaults to http://localhost:3000 locally.
SITE_URL=

# Random string of at least 32 characters (e.g. `openssl rand -base64 32`). Signs the session cookie.
AUTH_SECRET=

# Discord application (https://discord.com/developers/applications) -> OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Same application -> Bot -> Token. The bot must be on the server with Server Members Intent enabled.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Discord channel webhooks (Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL).
# Law votes use DISCORD_LAW_WEBHOOK_URL and fall back to DISCORD_WEBHOOK_URL if left empty.
DISCORD_WEBHOOK_URL=
DISCORD_LAW_WEBHOOK_URL=

# Language for Discord webhook announcements: en, hu, de, or sk (default: en)
ANNOUNCE_LANG=

# Comma-separated Discord role IDs (Server Settings -> Roles -> Copy Role ID)
ADMIN_ROLE_IDS=
EMPEROR_ROLE_IDS=

# Optional comma-separated role IDs allowed to log in and vote (leave empty to allow all server members)
LOGIN_ROLE_IDS=

# Random string used to HMAC-hash voters' IP addresses (raw IP addresses are never stored)
IP_HASH_SECRET=

# PostgreSQL connection string for production. Leave empty locally to use the embedded database in .pglite/
DATABASE_URL=

# Local testing without a Discord application: log in at /api/auth/login/?dev_user=1001&dev_name=Test
# DEV_FAKE_LOGIN=1
# DEV_FAKE_ROLES={"1001":["admin","emperor"],"1002":["senator"],"1003":[]}
