# Copy to .env.local for local development. On Vercel, set these in the project settings.

# Random string, at least 32 characters (e.g. `openssl rand -base64 32`). Signs the login cookie.
AUTH_SECRET=

# Discord application (https://discord.com/developers/applications) -> OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Same application -> Bot -> token. The bot must be on the server; it only reads members and roles.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=836271168977764363

# Webhooks: Edit channel -> Integrations -> Webhooks -> New webhook -> Copy URL
# Elections are posted to 『🗳️』elections, law votes to federal-gazette (falls back to the elections webhook if empty).
DISCORD_WEBHOOK_URL=
DISCORD_LAW_WEBHOOK_URL=
# Language of Discord posts: en, hu, de or sk (default en)
ANNOUNCE_LANG=

# Comma-separated Discord role ids (Server settings -> Roles -> right-click -> Copy role ID; needs Developer Mode)
ADMIN_ROLE_IDS=
EMPEROR_ROLE_IDS=
# Optional login/voting whitelist (leave empty to allow all server members to log in)
LOGIN_ROLE_IDS=

# Random string used to hash voters' IP addresses (raw IPs are never stored)
IP_HASH_SECRET=

# Set by the Neon integration on Vercel. Leave empty locally to use an embedded database in .pglite/
DATABASE_URL=

# Local testing without Discord: log in at /api/auth/login/?dev_user=1001&dev_name=Test
# DEV_FAKE_LOGIN=1
# DEV_FAKE_ROLES={"1001":["admin","emperor"],"1002":["senator"],"1003":[]}
